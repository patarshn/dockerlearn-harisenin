NODE_ENV=development
PORT=3000

# Untuk `npm run dev` di host, pakai 127.0.0.1 dan port DB yang di-publish (3307).
# Docker Compose meng-override nilai ini menjadi host `db` port 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_ROOT_PASSWORD="rootpass"
DB_NAME=crud_app
DB_USER=app
DB_PASSWORD="apppass"

JWT_SECRET="dev-secret-ganti-di-production-minimal-32-karakter"
JWT_ISSUER=sample4-api
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10

CORS_ORIGIN=*

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="Admin#12345"
